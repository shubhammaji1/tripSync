{
  "name": "tripsync-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint apps packages",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @tripsync/api db:generate",
    "db:migrate": "pnpm --filter @tripsync/api db:migrate",
    "db:seed": "pnpm --filter @tripsync/api db:seed",
    "typecheck": "node scripts/typecheck.cjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=8.15.9"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.3.2",
      "lodash": "^4.18.0",
      "fast-uri@2": "^2.4.7",
      "fast-uri@3": "^3.1.8",
      "brace-expansion@2": "^2.1.7",
      "engine.io": "^6.6.10",
      "source-map-js": "^1.2.2",
      "proxy-addr": "^2.0.8",
      "@fastify/middie": "^9.3.2",
      "find-my-way": "^9.7.0",
      "fastify": "^5.12.5",
      "brace-expansion@5": "^5.0.12"
    }
  }
}
