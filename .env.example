# ==========================================
# TripSync Environment Configuration
# ==========================================

# Environment & Ports
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Backend API
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# PostgreSQL Database (Supabase or Local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripsync
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tripsync

# Supabase Auth & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis (Cache, Pub/Sub & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# NextAuth / Session Secret (if needed)
NEXTAUTH_SECRET=super-secret-tripsync-session-token-key-32chars
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
