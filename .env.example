# ==========================================
# TripSync Environment Configuration
# ==========================================

# Environment & Ports
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Backend API
API_URL=http://localhost:4000/api/v1
WEB_URL=http://localhost:3000

# PostgreSQL Database (Supabase or Local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripsync
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tripsync

# Supabase Auth & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis (Cache, Pub/Sub & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# NextAuth / Session Secret (if needed)
NEXTAUTH_SECRET=super-secret-tripsync-session-token-key-32chars
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Clerk (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is safe for the web app;
# CLERK_SECRET_KEY must only be configured on the API/server.)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Email Sending (Optional: configure Resend OR standard SMTP / Gmail for live email delivery)
# Option A: Resend (Recommended)
RESEND_API_KEY=
# Option B: Standard SMTP or Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dontteachydhtb@gmail.com
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="TripSync <dontteachydhtb@gmail.com>"
